# Create a Supabase project, then copy these values from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Add these only in server-side environment variables when implementing trusted admin/provisioning tasks.
# Never expose service-role keys in NEXT_PUBLIC variables.
SUPABASE_SERVICE_ROLE_KEY=

# Daftar email admin dipisahkan koma. Jangan gunakan email user biasa.
ADMIN_EMAILS=admin@domain-kamu.com
# Service role hanya di server (Vercel Environment Variables), tidak pernah NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=

# Runtime Pterodactyl belum diaktifkan sampai adapter provision/start/stop diimplementasikan.
PTERODACTYL_URL=https://panel.domain-kamu.com
PTERODACTYL_APPLICATION_KEY=
PTERODACTYL_EGG_ID=
PTERODACTYL_NEST_ID=
